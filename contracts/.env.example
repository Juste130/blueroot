# RPC and explorer
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=

# Roles wired at deployment (comma-separated lists allowed)
ADMIN_ADDRESS=        # governance multisig (Safe). Accepts the admin role after ADMIN_DELAY.
TREASURY_ADDRESS=     # platform fee recipient
ANCHOR_ADDRESS=       # server wallet of the app (anchoring only)
VALIDATORS=
PROPONENTS=
PAYMENT_TOKEN=        # leave empty on testnet to deploy MockUSDC
ADMIN_DELAY=86400
CREDIT_URI=https://blueroot.app/api/credits/{id}

# Never put a private key here: import it once with `cast wallet import deployer --interactive`
