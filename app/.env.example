# Copy to .env.local (never committed). Server-only values have no NEXT_PUBLIC_ prefix and never reach
# the browser.

# --- Chain (public) -------------------------------------------------------------------------------
# 80002 = Polygon Amoy (demo network), 84532 = Base Sepolia, 31337 = local Anvil. Contract addresses are read from
# contracts/deployments/<chainId>.json, written by the Foundry deploy script.
NEXT_PUBLIC_CHAIN_ID=80002
# Optional: a dedicated RPC (the public endpoint is rate-limited). Also allowed by the CSP.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sessions (server) ----------------------------------------------------------------------------
# 32+ random characters: `openssl rand -base64 48`
SESSION_SECRET=

# --- IPFS / Pinata (server) -----------------------------------------------------------------------
# JWT with files read/write scopes. Without it, development stores documents in app/.data/.
PINATA_JWT=
# Your dedicated gateway domain, e.g. example.mypinata.cloud (private evidence links).
PINATA_GATEWAY=
# Gateway used to read public documents by CID.
IPFS_GATEWAY=https://gateway.pinata.cloud

# --- AI report (server) ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Anchoring service (server) -------------------------------------------------------------------
# Testnet key holding ANCHOR_ROLE only. It can anchor report hashes and nothing else.
ANCHOR_PRIVATE_KEY=
# Protects POST /api/reports/anchor (operator retries). 32+ random characters.
ANCHOR_API_SECRET=

# --- Field agents (server) ------------------------------------------------------------------------
# Comma-separated wallets allowed to send evidence for every project (besides owner and community).
FIELD_AGENT_ADDRESSES=

# Max block range per eth_getLogs call (lower it for providers with stricter limits).
LOG_CHUNK_BLOCKS=9000
