{
  "name": "blueroot",
  "version": "0.1.0",
  "private": true,
  "description": "BlueRoot: proof registry for community blue carbon (mangroves, Benin)",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "scripts/satellite"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "abi": "node scripts/gen-abi.mjs",
    "demo": "node scripts/demo.ts",
    "api-check": "node scripts/api-check.ts",
    "satellite": "npm run --workspace @blueroot/satellite"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@blueroot/satellite": "1.0.0",
    "@privy-io/react-auth": "3.50.0",
    "@privy-io/wagmi": "4.0.19",
    "@tanstack/react-query": "5.104.2",
    "exifr": "7.1.3",
    "h3-js": "4.2.1",
    "jose": "6.2.12",
    "maplibre-gl": "6.14.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "viem": "2.57.5",
    "wagmi": "3.7.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.13.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.0.9"
  }
}
