{
  "name": "blueroot",
  "private": true,
  "description": "BlueRoot: proof registry for community blue carbon (mangroves, Benin)",
  "license": "MIT",
  "workspaces": [
    "scripts/satellite",
    "app"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm run --workspace @blueroot/app dev",
    "build": "npm run --workspace @blueroot/app build",
    "satellite": "npm run --workspace @blueroot/satellite",
    "app": "npm run --workspace @blueroot/app",
    "test": "npm run --workspaces --if-present test",
    "typecheck": "npm run --workspaces --if-present typecheck"
  }
}
