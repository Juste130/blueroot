{
  "name": "@blueroot/satellite",
  "version": "1.0.0",
  "private": true,
  "description": "Sentinel-2 NDVI pipeline producing versioned, hashable series for BlueRoot zones",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./zones": "./src/zones.ts",
    "./schema": "./src/schema.ts",
    "./canonical": "./src/canonical.ts",
    "./score": "./src/score.ts"
  },
  "scripts": {
    "compute": "tsx src/cli.ts compute",
    "verify": "tsx src/cli.ts verify",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "geotiff": "2.1.3",
    "h3-js": "4.2.1",
    "proj4": "2.15.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/proj4": "2.5.6",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.0.9"
  }
}
